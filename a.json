{{
  (() => {
    const raw = $('Webhook Ticket en Proceso').item.json.body.issue.fields.customfield_10064 || '';
    const regex = /\[([^|\]]+)\|([^\]]+)\]/g;
    const blocks = [];
    let match;

    while ((match = regex.exec(raw)) !== null) {
      const name = match[1].trim();
      const url = match[2].trim();
      blocks.push(`[${name}](${url})`);
    }

    // Devolver un string, no un array
    return blocks.join('\n');
  })()
}}

